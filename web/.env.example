# Copy to .env.local for local development. In Cloudflare Pages, set these
# under Settings → Environment variables instead. All three are PUBLIC by
# design — they end up in the browser bundle. Never put the service_role key
# (or any other secret) in a VITE_ variable.

# Project URL: the bare origin, WITHOUT /rest/v1.
VITE_SUPABASE_URL=https://<project>.supabase.co
# Publishable (anon) key, starts with sb_publishable_
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx
# The Cloud Run service URL (no trailing slash). Locally: http://127.0.0.1:8000
VITE_API_URL=http://127.0.0.1:8000

# LOCAL DEVELOPMENT ONLY. When set during `npm run dev`, the app skips the
# Supabase login and sends this string as the bearer token — useful with an
# API whose login dependency is overridden. Ignored by `npm run build`: the
# check is behind import.meta.env.DEV, which is false in production bundles.
# VITE_DEV_FAKE_TOKEN=dev
